# bz/.env — LOCAL DEV CREDENTIALS for the bz PostgreSQL stack.
#
# ⚠ EVERY VALUE IN THIS FILE IS A LOCAL-ONLY DEVELOPMENT SECRET. ⚠
# It exists so `docker compose up` works on a laptop with no setup, and it is
# therefore committed on purpose. Never reuse any of it anywhere real; a real
# deployment takes these from a secret store, not from a file in the tree.
#
# This file is INDEPENDENT of ../deploy/.env. The two stacks share no
# credentials, no ports and no data — changing one does not affect the other,
# and nothing reads ../deploy/.env.

# ── Images ────────────────────────────────────────────────────────────────────
# Same Dockerfile as the CORE stack (../deploy/infrastructure/pg), pinned.
REPO_NAME=georgelza
CITUS_REPMGR_VERSION=12.1.14
# 1.26.0 is the first line with `load_balance_hosts` (added in 1.24.0), which the
# READ proxy's host list uses explicitly. It also carries the 1.25.2/1.26.0 CVE
# fixes (CVE-2026-6664/6665/6666/6667, CVE-2026-19888, CVE-2026-6668/6669).
PGBOUNCER_VERSION=v1.26.0-p0
# Pgpool-II is the WRITE endpoint's failover brain. 4.3 is the first line with
# PostgreSQL 16 support, which is what these nodes run — so pgpool2 and PG move
# together, exactly as Citus does (infrastructure/pg/Dockerfile).
PGPOOL2_VERSION=4.3.5

# ── Node identity (must match `hostname:` on each service) ────────────────────
PG_PRIMARY_NODE_NAME=bz-pg-primary
PG_REPLICA_NODE_NAME=bz-pg-replica

# ── Bootstrap superuser ──────────────────────────────────────────────────────
# POSTGRES_USER/PASSWORD is the image's own superuser; PG_DB_NAME is the
# database docker-entrypoint-initdb.d connects to for admin statements. It is
# NOT the application database (see BZ_DB_NAME below).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=bz_pg_primary_dev_pw
PG_DB_NAME=postgres

# ── Application database (created by sql/postgresdb/01_bootstrap.sh) ──────────
BZ_DB_NAME=bzdb

# ── Roles ────────────────────────────────────────────────────────────────────
# Written to conf/pgbouncer/{rw,ro}/userlist.txt by scripts/gen_pgbouncer_userlist.sh.
PG_APP_USER=bz_app
PG_APP_PASSWORD=bz_app_dev_pw
# Read-only role, and the ONLY role the read proxy accepts. Locked twice over:
# no DML grants at all, plus ALTER ROLE ... SET default_transaction_read_only=on.
PG_RO_USER=bz_ro
PG_RO_PASSWORD=bz_ro_dev_pw
PG_ADMIN_USER=bz_admin
PG_ADMIN_PASSWORD=bz_admin_dev_pw
# Streaming replication role. Deliberately NOT in userlist.txt — replication
# connects to PostgreSQL directly and never traverses PgBouncer.
PG_REPL_USER=replicator
PG_REPL_PASSWORD=bz_repl_dev_pw
# PgBouncer's own admin-console identity (virtual `pgbouncer` database, NOT a
# PostgreSQL role).
PGPOOL_ADMIN_USER=pgbouncer
PGPOOL_ADMIN_PASSWORD=bz_pgbouncer_dev_pw

# ── Failover (promotion) credentials ─────────────────────────────────────────
# Used ONLY by conf/pgpool2/failover.sh, to run SELECT pg_promote() on the node
# being promoted. pg_promote() is restricted to superusers, so this is the image's
# bootstrap superuser. It is not an application credential and is never given to
# the app; if this stack ever went near production the promotion role would be a
# dedicated role granted EXECUTE on pg_promote instead of a superuser.
PG_PROMOTE_USER=postgres

# ── Published ports ──────────────────────────────────────────────────────────
# 6433/6434 rather than 6432: the CORE stack's PgBouncer already owns 6432 on
# this host, and the two stacks are meant to be runnable side by side.
HOST_PORT_PROXY_RW=6433
HOST_PORT_PROXY_RO=6434
